    transform: { x: 80; y: 111; };
    text: { content: "A quiet moment, drawn in curves."; font: @nunito; size: 18; };

  }
  actor subtitle {
    parts: (@subtitle);
    transform: { x: 0; y: 0; };
    layer: 100;

  }
  part caption {
    material: { fill: "#3f354d"; stroke: null; strokeWidth: 0; };
    layer: 0;
    transform: { x: 81; y: 680; };
    text: { content: "Notice."; font: @nunito; size: 25; };

  }
  actor caption {
    parts: (@caption);
    transform: { x: 0; y: 0; };
    layer: 100;

  }
  part captionReach {
    material: { fill: "#3f354d"; stroke: null; strokeWidth: 0; };
    layer: 0;
    transform: { x: 81; y: 680; };
    text: { content: "Reach. Hold."; font: @nunito; size: 25; };

  }
  actor captionReach {
    parts: (@captionReach);
    transform: { x: 0; y: 0; };
    layer: 100;

  }
  part captionClose {
    material: { fill: "#3f354d"; stroke: null; strokeWidth: 0; };
    layer: 0;
    transform: { x: 81; y: 680; };
    text: { content: "Keep a little light."; font: @nunito; size: 25; };

  }
  actor captionClose {
    parts: (@captionClose);
    transform: { x: 0; y: 0; };
    layer: 100;

  }
  shape pulseShape {

    contour outline {
      start: (0, 0);
      closed: true;
      cubic s0 {
        control1: (9.333, 0);
        control2: (18.667, 0);
        end: (28, 0);

      }
      cubic s1 {
        control1: (28, 2.667);
        control2: (28, 5.333);
        end: (28, 8);

      }
      cubic s2 {
        control1: (18.667, 8);
        control2: (9.333, 8);
        end: (0, 8);

      }
      cubic s3 {
        control1: (0, 5.333);
        control2: (0, 2.667);
        end: (0, 0);

      }
    }
  }
  part syncPulse {
    shape: @pulseShape;
    material: { fill: "#f1b955"; stroke: null; strokeWidth: 0; };
    layer: 0;
    transform: {  };

  }
  actor sync {
    parts: (@syncPulse);
    transform: { x: 1170; y: 82; };
    layer: 120;

  }
  pose idle {
    parts: { frontArm: { shape: @armRest; }; hand: { transform: { x: 115; y: 85; }; }; mouth: { shape: @mouthNeutral; }; };

  }
  pose reach {
    parts: { frontArm: { shape: @armReach; }; hand: { transform: { x: 225; y: -18; }; }; mouth: { shape: @mouthNeutral; }; };

  }
  pose lift {
    parts: { frontArm: { shape: @armLift; }; hand: { transform: { x: 120; y: -95; }; }; mouth: { shape: @mouthNeutral; }; };

  }
  pose smile {
    parts: { frontArm: { shape: @armLift; }; hand: { transform: { x: 120; y: -95; }; }; mouth: { shape: @mouthSmile; }; };

  }
  drawing eyesOpen {
    parts: { eyes: @eyeOpen; };

  }
  drawing eyesClosed {
    parts: { eyes: @eyeClosed; };

  }
  scene moment {

    shot notice {
      duration: 144f;
      initial sync {
        visible: false;

      }
      initial captionReach {
        visible: false;

      }
      initial captionClose {
        visible: false;

      }
      key pulseOn {
        target: @sync;
        property: "visible";
        frame: 24f;
        value: true;

      }
      key pulseOff {
        target: @sync;
        property: "visible";
        frame: 27f;
        value: false;

      }
      key b0 {
        target: @hero;
        property: "y";
        frame: 0f;
        value: 380;
        easing: (0.42, 0, 0.58, 1);

      }
      key b1 {
        target: @hero;
        property: "y";
        frame: 36f;
        value: 377;
        easing: (0.42, 0, 0.58, 1);

      }
      key b2 {
        target: @hero;
        property: "y";
        frame: 72f;
        value: 380;
        easing: (0.42, 0, 0.58, 1);

      }
      key b3 {
        target: @hero;
        property: "y";
        frame: 108f;
        value: 377;
        easing: (0.42, 0, 0.58, 1);

      }
      key b4 {
        target: @hero;
        property: "y";
        frame: 143f;
        value: 380;
        easing: (0.42, 0, 0.58, 1);

      }
      key look0 {
        target: @hero.eyes;
        property: "x";
        frame: 0f;
        value: 0;
        hold: 2f;

      }
      key look1 {
        target: @hero.eyes;
        property: "x";
        frame: 72f;
        value: 5;
        hold: 2f;

      }
      expose firstBlink {
        actor: @hero;
        drawing: @eyesClosed;
        start: 103f;
        end: 106f;

      }
      camera wide {
        x: 0;
        y: 0;

      }
    }
    shot reachAndLift {
      duration: 192f;
      initial caption {
        visible: false;

      }
      initial captionReach {
        visible: true;

      }
      initial sync {
        visible: false;

      }
      key pulseOn {
        target: @sync;
        property: "visible";
        frame: 24f;
        value: true;

      }
      key pulseOff {
        target: @sync;
        property: "visible";
        frame: 27f;
        value: false;

      }
      morph reachMotion {
        actor: @hero;
        from: @idle;
        to: @reach;
        start: 0f;
        end: 60f;
        easing: (0.4, 0, 0.2, 1);

      }
      morph liftMotion {
        actor: @hero;
        from: @reach;
        to: @lift;
        start: 72f;
        end: 130f;
        easing: (0.4, 0, 0.2, 1);

      }
      key armOcclusion {
        target: @hero.frontArm;
        property: "layer";
        frame: 50f;
        value: 50;

      }
      key handOcclusion {
        target: @hero.hand;
        property: "layer";
        frame: 50f;
        value: 55;

      }
      key contact {
        target: @lantern;
        property: "parent";
        frame: 60f;
        value: @hero.hand;

      }
      key anchorX {
        target: @lantern;
        property: "x";
        frame: 60f;
        value: 0;

      }
      key anchorY {
        target: @lantern;
        property: "y";
        frame: 60f;
        value: 20;

      }
      expose reachBlink {
        actor: @hero;
        drawing: @eyesClosed;
        start: 166f;
        end: 169f;

      }
      camera reachCamera {
        x: 0;
        y: 0;

      }
      key camera0 {
        target: @camera;
        property: "x";
        frame: 0f;
        value: 0;

      }
      key camera1 {
        target: @camera;
        property: "x";
        frame: 150f;
        value: 20;

      }
    }
    shot keep {
      duration: 144f;
      initial captionReach {
        visible: false;

      }
      initial captionClose {
        visible: true;
        x: 245;
        y: 105;
        scaleX: 0.62;
        scaleY: 0.62;

      }
      initial title {
        visible: false;

      }
      initial subtitle {
        visible: false;

      }
      initial sync {
        visible: false;
        x: 970.4;
        y: 155.84;
        scaleX: 0.62;
        scaleY: 0.62;

      }
      key pulseOn {
        target: @sync;
        property: "visible";
        frame: 24f;
        value: true;

      }
      key pulseOff {
        target: @sync;
        property: "visible";
        frame: 27f;
        value: false;

      }
      camera close {
        x: 245;
        y: 105;
        scaleX: 0.62;
        scaleY: 0.62;

      }
      morph expression {
        actor: @hero;
        from: @lift;
        to: @smile;
        start: 12f;
        end: 72f;
        easing: (0.4, 0, 0.2, 1);

      }
      expose closeBlink {
        actor: @hero;
        drawing: @eyesClosed;
        start: 91f;
        end: 94f;

      }
      key gaze0 {
        target: @hero.eyes;
        property: "x";
        frame: 0f;
        value: 5;
        hold: 2f;

      }
      key gaze1 {
        target: @hero.eyes;
        property: "x";
        frame: 36f;
        value: 1;
        hold: 2f;

      }
    }
  }
  audio soundtrack {
    asset: @score;
    offset: 0f;
    trimStart: 0f;
    duration: 480f;
    gain: 1;

  }
}
