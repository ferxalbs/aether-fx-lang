module art {
  asset nunito {
    kind: "font";
    src: "assets/Nunito.ttf";
    version: 1;
    locked: true;
  }
  asset paper {
    kind: "image";
    src: "assets/paper.png";
    version: 1;
    locked: true;
  }
  asset score {
    kind: "audio";
    src: "assets/score.wav";
    version: 1;
    locked: true;
  }
  shape wallShape {
    primitive: "rect";
    size: [1650, 1000];
  }
  part wall {
    shape: @wallShape;
    material: { fill: { type: "linear"; from: [100, 100]; to: [1120, 600]; stops: [{ offset: 0; color: "#f4ebd9"; }, { offset: 1; color: "#e3d4c2"; }]; }; };
    layer: 0;
    transform: { x: -150; y: -150; };
  }
  shape floorShape {
    primitive: "polygon";
    points: [[-150, 568], [1500, 655], [1500, 905], [-150, 905]];
  }
  part floor {
    shape: @floorShape;
    material: { fill: { type: "linear"; from: [420, 600]; to: [1000, 850]; stops: [{ offset: 0; color: "#d3bfa8"; }, { offset: 1; color: "#b9a090"; }]; }; };
