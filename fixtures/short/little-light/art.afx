  audio soundtrack {
    asset: @score;
    offset: 0f;
    trimStart: 0f;
    duration: 480f;
    gain: 1;
  }
  theme wood {
    top: "#ba8b70";
    light: "#a57561";
    dark: "#80565a";
  }
  component leg {
    params: { ring: [{ id: "a"; point: [650, 14]; }, { id: "b"; point: [670, 14]; }, { id: "c"; point: [670, 30]; }, { id: "d"; point: [650, 30]; }]; };
    solid post {
      kind: "extrude";
      ring: @ring;
      z: -696;
      height: 159;
      projection: @tableView;
      materials: { top: @wood.top; light: @wood.light; dark: @wood.dark; };
      layer: 40;
      transform: { x: @tableX; };
    }
  }
  instance left {
    component: @leg;
  }
  instance right {
    component: @leg;
    args: { ring: [{ id: "a"; point: [917, 14]; }, { id: "b"; point: [937, 14]; }, { id: "c"; point: [937, 30]; }, { id: "d"; point: [917, 30]; }]; };
  }
  solid table {
    kind: "extrude";
    height: 20;
    z: -537;
    projection: @tableView;
    ring: [{ id: "backLeft"; point: [585, -40]; }, { id: "backRight"; point: [1000, -40]; }, { id: "frontRight"; point: [1000, 40]; }, { id: "frontLeft"; point: [585, 40]; }];
    materials: { top: @wood.top; light: @wood.light; dark: @wood.dark; };
    layer: 44;
    transform: { x: @tableX; };
  }
  instance housing {
    component: @turnedPiece;
    args: { radius: 30; height: 64; z: -72; materials: { top: "#f9d58a"; light: "#e3a24b"; dark: "#ac723d"; }; parent: @lantern.lanternBody; layer: 60; };
  }
  instance lampFoot {
    component: @turnedPiece;
    args: { radius: 33; height: 9; z: -80; materials: { top: "#ad8370"; light: "#956958"; dark: "#704e4d"; }; parent: @lantern.lanternBody; layer: 64; };
  }
  instance lampRim {
    component: @turnedPiece;
    args: { radius: 31; height: 5; z: -8; materials: { top: "#f9d58a"; light: "#ad8370"; dark: "#704e4d"; }; parent: @lantern.lanternBody; layer: 62; };
