    primitive: "path";
    data: "M -16 1 C -17 -10 -17 -24 -12 -29 C -6 -37 6 -37 12 -29 C 17 -24 17 -10 16 1 L 9 1 C 10 -10 11 -20 7 -24 C 3 -29 -3 -29 -7 -24 C -11 -20 -10 -10 -9 1 Z";
  }
