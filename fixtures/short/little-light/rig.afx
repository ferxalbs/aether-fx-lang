module rig {
  theme reachRig {
    lengths: (104, 120);
    grip: (18, -5);
    crown: (-2, -31);
  }
  part frontArm {
    shape: @upperSleeve;
    material: @palette.sleeve;
    layer: 11;
    transform: { x: 45; y: 10; rotation: 0deg; };
    parent: @torsoRig;
  }
  part hand {
    shape: @palmOpen;
    material: { fill: "#dca17f"; };
    layer: 39;
    transform: { x: 120; y: 0; rotation: 0deg; };
    parent: @foreArm;
    anchors: { grip: @reachRig.grip; };
  }
  actor hero {
    parts: [@torsoRig, @headRig, @backArm, @legs, @shoes, @neck, @body, @collar, @head, @hair, @eyes, @nose, @mouth, @frontArm, @foreArm, @cuff, @elbowFold, @hand, @thumb, @fingers];
    transform: { x: 420; y: 380; };
    layer: 20;
  }
  drawing eyesOpen {
    parts: { eyes: @eyeOpen; };
  }
  drawing eyesClosed {
    parts: { eyes: @eyeClosed; };
  }
  shape blank {
    contour anchor {
      start: [0, 0];
      closed: false;
    }
  }
  part thumb {
    shape: @thumbOpen;
    parent: @hand;
    transform: {  };
    layer: 47;
    material: { fill: "#d49678"; };
  }
  part fingers {
    shape: @fingersOpen;
    parent: @hand;
    layer: 46;
    material: { fill: "#efbd99"; };
    transform: {  };
  }
  shape upperSleeve {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [-12, -10];
      }
      node n1 {
        point: [0, -22];
      }
      node n2 {
        point: [28, -22];
      }
      node n3 {
        point: [92, -17];
      }
      node n4 {
        point: [110, -8];
      }
      node n5 {
        point: [111, 8];
      }
      node n6 {
        point: [92, 17];
      }
      node n7 {
        point: [28, 22];
      }
      node n8 {
        point: [0, 18];
      }
      node n9 {
        point: [-12, 8];
      }
    }
  }
  shape foreSleeve {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [-14, -11];
      }
      node n1 {
        point: [0, -17];
      }
      node n2 {
        point: [32, -16];
      }
      node n3 {
        point: [101, -12];
      }
      node n4 {
        point: [121, -10];
      }
      node n5 {
        point: [125, 0];
      }
      node n6 {
        point: [121, 11];
      }
      node n7 {
        point: [98, 13];
      }
      node n8 {
        point: [28, 17];
      }
      node n9 {
        point: [0, 16];
      }
      node n10 {
        point: [-14, 10];
      }
    }
  }
  shape cuffShape {
    primitive: "roundedRect";
    size: [10, 25];
    radius: 3;
  }
  shape elbowFold {
    contour fold {
      closed: false;
      node a {
        point: [-3, 10];
        out: [4, 3];
      }
      node b {
        point: [10, 12];
        in: [-4, 1];
      }
    }
  }
  part torsoRig {
    shape: @blank;
    material: { fill: null; };
    pivot: [0, 142];
    transform: { rotation: 0deg; };
  }
  part headRig {
    shape: @blank;
    material: { fill: null; };
    parent: @torsoRig;
    pivot: [0, -90];
    transform: { y: 14; rotation: 4deg; };
  }
  part foreArm {
    shape: @foreSleeve;
    parent: @frontArm;
    transform: { x: 104; rotation: 0deg; };
    layer: 12;
    material: @palette.sleeve;
  }
  part cuff {
    shape: @cuffShape;
    parent: @foreArm;
    transform: { x: 110; y: -12.5; };
    layer: 13;
    material: { fill: "#315f68"; };
  }
  part elbowFold {
    shape: @elbowFold;
    parent: @foreArm;
    layer: 14;
    material: { fill: null; stroke: "#477a7d"; strokeWidth: 2; };
  }
  shape palmOpen {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [-12, -8];
      }
      node n1 {
        point: [-3, -12];
      }
      node n2 {
        point: [9, -11];
      }
      node n3 {
        point: [19, -8];
      }
      node n4 {
        point: [22, -3];
      }
      node n5 {
        point: [18, 3];
      }
      node n6 {
        point: [10, 8];
      }
      node n7 {
        point: [0, 10];
      }
      node n8 {
        point: [-10, 7];
      }
    }
  }
  shape palmClosing {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [-12, -8];
      }
      node n1 {
        point: [-3, -12];
      }
      node n2 {
        point: [10, -12];
      }
      node n3 {
        point: [18, -9];
      }
      node n4 {
        point: [21, -3];
      }
      node n5 {
        point: [17, 4];
      }
      node n6 {
        point: [9, 10];
      }
      node n7 {
        point: [-1, 10];
      }
      node n8 {
        point: [-10, 7];
      }
    }
  }
  shape palmHolding {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [-12, -8];
      }
      node n1 {
        point: [-3, -12];
      }
      node n2 {
        point: [9, -12];
      }
      node n3 {
        point: [16, -9];
      }
      node n4 {
        point: [20, -3];
      }
      node n5 {
        point: [17, 5];
      }
      node n6 {
        point: [9, 11];
      }
      node n7 {
        point: [-1, 10];
      }
      node n8 {
        point: [-10, 7];
      }
    }
  }
  shape fingersOpen {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [10, -11];
      }
      node n1 {
        point: [24, -14];
      }
      node n2 {
        point: [31, -12];
      }
      node n3 {
        point: [33, -8];
      }
      node n4 {
        point: [30, -5];
      }
      node n5 {
        point: [18, -4];
      }
      node n6 {
        point: [12, 0];
      }
    }
  }
  shape fingersClosing {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [12, -11];
      }
      node n1 {
        point: [24, -10];
      }
      node n2 {
        point: [28, -7];
      }
      node n3 {
        point: [29, 3];
      }
      node n4 {
        point: [25, 7];
      }
      node n5 {
        point: [21, 3];
      }
      node n6 {
        point: [21, -3];
      }
      node n7 {
        point: [13, -1];
      }
    }
  }
  shape fingersHolding {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [12, -10];
      }
      node n1 {
        point: [21, -11];
      }
      node n2 {
        point: [26, -8];
      }
      node n3 {
        point: [26, 4];
      }
      node n4 {
        point: [23, 10];
      }
      node n5 {
        point: [19, 12];
      }
      node n6 {
        point: [15, 8];
      }
      node n7 {
        point: [14, 0];
      }
    }
  }
  shape thumbOpen {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [2, 6];
      }
      node n1 {
        point: [8, 3];
      }
      node n2 {
        point: [16, 4];
      }
      node n3 {
        point: [22, 9];
      }
      node n4 {
        point: [21, 13];
      }
      node n5 {
        point: [15, 12];
      }
      node n6 {
        point: [9, 10];
      }
      node n7 {
        point: [4, 13];
      }
    }
  }
  shape thumbClosing {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [3, 7];
      }
      node n1 {
        point: [10, 7];
      }
      node n2 {
        point: [19, 1];
      }
      node n3 {
        point: [23, 3];
      }
      node n4 {
        point: [21, 8];
      }
      node n5 {
        point: [15, 14];
      }
      node n6 {
        point: [8, 15];
      }
      node n7 {
        point: [3, 12];
      }
    }
  }
  shape thumbHolding {
    contour outline {
      closed: true;
      curve: "catmull-rom";
      node n0 {
        point: [3, 8];
      }
      node n1 {
        point: [10, 7];
      }
      node n2 {
        point: [17, 1];
      }
      node n3 {
        point: [21, 0];
      }
      node n4 {
        point: [24, 3];
      }
      node n5 {
        point: [21, 8];
      }
      node n6 {
        point: [16, 14];
      }
      node n7 {
        point: [8, 16];
      }
      node n8 {
        point: [3, 13];
      }
    }
  }
  drawing handOpen {
    parts: { hand: @palmOpen; fingers: @fingersOpen; thumb: @thumbOpen; };
  }
  drawing handClosing {
    parts: { hand: @palmClosing; fingers: @fingersClosing; thumb: @thumbClosing; };
  }
  drawing handHolding {
    parts: { hand: @palmHolding; fingers: @fingersHolding; thumb: @thumbHolding; };
  }
  // One chain recipe; poses retain their stable names and only author goals.
  component reachArm {
    params: { target: @lantern; point: @reachRig.crown; offset: (0, 0); angle: 0deg; initial: false; };
    arm reach {
      actor: @hero;
      upper: @frontArm;
      fore: @foreArm;
      hand: @hand;
      lengths: @reachRig.lengths;
      target: @target;
      point: @point;
      offsetPoint: @offset;
      grip: @reachRig.grip;
      elbow: negative;
      rotation: @angle;
      initial: @initial;
    }
  }
  pose idle {
    parts: { torsoRig: { transform: { rotation: 0deg; }; }; headRig: { transform: { rotation: 4deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { target: [543.33, 528.088]; angle: 60deg; initial: true; point: (0, 0); };
    }
  }
  pose anticipate {
    parts: { torsoRig: { transform: { rotation: -1.8deg; }; }; headRig: { transform: { rotation: 4deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { target: [526, 514]; angle: 50deg; point: (0, 0); };
    }
  }
  pose reachArc {
    parts: { torsoRig: { transform: { rotation: 2.5deg; }; }; headRig: { transform: { rotation: 3.5deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-48, -14]; angle: -8deg; };
    }
  }
  pose near {
    parts: { torsoRig: { transform: { rotation: 2.5deg; }; }; headRig: { transform: { rotation: 3deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-6, 0]; };
    }
  }
  pose reach {
    parts: { torsoRig: { transform: { rotation: 2.5deg; }; }; headRig: { transform: { rotation: 3deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
    }
  }
  pose liftArc {
    parts: { torsoRig: { transform: { rotation: 1deg; }; }; headRig: { transform: { rotation: 1.5deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-24, -42.5]; };
    }
  }
  pose lift {
    parts: { torsoRig: { transform: { rotation: 0deg; }; }; headRig: { transform: { rotation: 0.5deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-83, -67.5]; };
    }
  }
  pose settled {
    parts: { torsoRig: { transform: { rotation: 0.4deg; }; }; headRig: { transform: { rotation: 0.2deg; }; }; mouth: { shape: @mouthNeutral; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-80, -61.5]; };
    }
  }
  pose smile {
    parts: { torsoRig: { transform: { rotation: 0.4deg; }; }; headRig: { transform: { rotation: 0.2deg; }; }; mouth: { shape: @mouthSmile; }; };
    instance goal {
      component: @reachArm;
      args: { offset: [-80, -61.5]; };
    }
  }
}
