{
  "name": "aether-fx-lang",
  "version": "0.1.0",
  "description": "AetherFX Language",
  "license": "ISC",
  "private": true,
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "verify:foundation": "npm run check && node scripts/verify-foundation.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "verify:node": "npm run check && node scripts/verify-node-lifecycle.mjs && node scripts/verify-node-packages.mjs",
    "verify:react": "npm run check && node scripts/verify-react-next.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
