{
  "name": "aether-fx-lang",
  "version": "0.2.0-rc.3",
  "description": "AetherFX Language",
  "license": "Apache-2.0",
  "private": true,
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "npm run release:check && npm run build && npm run typecheck && npm test",
    "verify:foundation": "npm run check && node scripts/verify-foundation.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "verify:node": "npm run check && node scripts/verify-node-lifecycle.mjs && node scripts/verify-node-packages.mjs",
    "verify:react": "npm run check && node scripts/verify-react-next.mjs",
    "verify:web": "npm run check && node scripts/verify-web-export.mjs",
    "release:sync": "node scripts/sync-release.mjs --write",
    "release:check": "node scripts/sync-release.mjs --check",
    "lint": "node scripts/lint.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:authoring": "node scripts/verify-authoring.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "playground:build": "node scripts/build-playground.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@mediabunny/aac-encoder": "1.61.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferxalbs/aether-fx-lang.git"
  },
  "homepage": "https://github.com/ferxalbs/aether-fx-lang#readme",
  "bugs": {
    "url": "https://github.com/ferxalbs/aether-fx-lang/issues"
  }
}
